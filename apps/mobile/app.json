{
  "expo": {
    "name": "Ustara",
    "slug": "ustara",
    "scheme": "ustara",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.ustara.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.ustara.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F5F4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1F5F4A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ustara sartarosh rasmini yuklash uchun galereyangizga kirishni soʻraydi.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "562337f1-7398-4fdb-ac41-fc83697b43b9"
      }
    },
    "owner": "okhunjon"
  }
}
